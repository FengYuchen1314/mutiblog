{
  "name": "@mutiblog/console",
  "private": true,
  "version": "0.1.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "codemirror": "^6.0.2",
    "mathjax": "3.2.2",
    "markdown-it": "^14.1.0",
    "@iconify/vue": "^5.0.0",
    "@tanstack/vue-query": "^5.87.1",
    "@vueuse/core": "^12.8.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@types/node": "^24.11.0",
    "@types/markdown-it": "^14.1.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.13",
    "vue-tsc": "^3.2.4"
  }
}
