{
  "name": "mutiblog",
  "private": true,
  "version": "0.1.0-dev",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev:console": "pnpm --filter @mutiblog/console dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm --filter @mutiblog/console lint",
    "format": "pnpm --filter @mutiblog/console format",
    "format:check": "pnpm --filter @mutiblog/console format:check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
