# Run with: BLOG_DOMAIN=blog.example.com docker compose -f docker-compose.yml -f deploy/compose.caddy.yml up -d
# Caddy owns TLS certificates; the blog service keeps its normal HTTP port.
{$BLOG_DOMAIN:localhost} {
    encode zstd gzip

    handle = / { reverse_proxy blog:8080 }
    handle /admin/* { reverse_proxy blog:8080 }
    handle /api/* { reverse_proxy blog:8080 }
    handle /healthz { reverse_proxy blog:8080 }
    handle /media/* {
        root * /srv
        header X-Content-Type-Options nosniff
        file_server
    }
    handle /assets/* {
        root * /srv/generated/public
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/generated/public
        try_files {path} {path}/index.html /zh-cn/404.html
        header Cache-Control "public, max-age=300, must-revalidate"
        file_server
    }
}
