mutiblog.nl.chrono-well.top {
	encode zstd gzip

	handle_path /media/* {
		root * /srv/mutiblog/media/originals
		file_server
	}

	handle {
		reverse_proxy mutiblog-app:8080
	}

	handle_errors 502 503 504 {
		root * /srv/mutiblog/generated/current
		@last_release file {path} {path}/index.html
		handle @last_release {
			rewrite {file_match.relative}
			header Cache-Control "no-cache"
			file_server {
				status 200
			}
		}
		respond "Publishing service temporarily unavailable" {err.status_code}
	}

	@private {
		path /api/* /console/* /health/*
		not path /console/assets/*
	}
	header @private Cache-Control "no-store"
	@immutable_assets path /console/assets/* /media/*
	header @immutable_assets Cache-Control "public, max-age=31536000, immutable"
	@public_assets path /assets/*
	header @public_assets Cache-Control "public, max-age=3600"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'"
		-Server
	}

	log {
		output stdout
		format console
	}
}

preview.nl.chrono-well.top {
	encode zstd gzip
	@blocked path /console* /api/v1/admin* /api/v1/auth* /api/v1/setup* /health*
	respond @blocked 404

	handle_path /media/* {
		root * /srv/mutiblog/media/originals
		file_server
	}

	handle {
		reverse_proxy mutiblog-app:8080
	}

	header {
		Cache-Control "private, no-store"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
